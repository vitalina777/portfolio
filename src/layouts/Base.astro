---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, withBase } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props { title?: string; description?: string; current?: 'work' | 'about'; }
const { title, description = site.description, current } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const path = Astro.url.pathname.endsWith('/') || /\.(html|xml|pdf|png|svg|txt)$/.test(Astro.url.pathname) ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL(withBase('/og.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    {site.goatcounter && (
      <script is:inline async data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`} data-goatcounter-settings='{"no_onload": true, "no_events": true}' src="https://gc.zgo.at/count.js"></script>
    )}
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      function initReveal() {
        document.querySelectorAll('[data-reveal-group]').forEach((g) => {
          [...g.children].forEach((c, i) => {
            c.setAttribute('data-reveal', '');
            (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 6)));
          });
        });
        const els = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          els.forEach((e) => e.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((e) => io.observe(e));
      }
      document.addEventListener('astro:page-load', initReveal);


      // Privacy-friendly analytics (GoatCounter, no cookies).
      // Counts every page view, including smooth client-side navigation,
      // plus clicks on the CV, LinkedIn and email links.
      type GC = { count: (o: Record<string, unknown>) => void };
      const gc = () => (window as unknown as { goatcounter?: GC }).goatcounter;
      function whenReady(fn: () => void, tries = 25) {
        if (gc()?.count) fn();
        else if (tries > 0) setTimeout(() => whenReady(fn, tries - 1), 200);
      }
      // First view keeps the real referrer (and ?ref=… tags); later views come from the previous page
      let prevUrl = '';
      document.addEventListener('astro:page-load', () => {
        const opts: Record<string, unknown> = { path: location.pathname, title: document.title };
        if (prevUrl) opts.referrer = prevUrl;
        prevUrl = location.href;
        whenReady(() => gc()!.count(opts));
      });
      // Reading depth (every 10%) and sections reached, per page
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const pageName = () => {
        const p = location.pathname.slice(base.length).replace(/^\/|\/$/g, '');
        return p === '' ? 'home' : p.replace(/^work\//, '');
      };
      const sendEvent = (path: string) => whenReady(() => gc()!.count({ path, title: path, event: true }));
      let sentDepth = new Set<number>();
      let sectionObserver: IntersectionObserver | null = null;
      let ticking = false;
      const checkDepth = () => {
        ticking = false;
        const doc = document.documentElement;
        const pct = Math.min(100, ((window.scrollY + window.innerHeight) / doc.scrollHeight) * 100);
        for (let t = 10; t <= 100; t += 10) {
          if (pct >= t - 0.5 && !sentDepth.has(t)) { sentDepth.add(t); sendEvent(`${pageName()} · read ${t}%`); }
        }
      };
      window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(checkDepth); } }, { passive: true });
      document.addEventListener('astro:page-load', () => {
        sentDepth = new Set();
        setTimeout(checkDepth, 800);
        sectionObserver?.disconnect();
        const seen = new Set<string>();
        sectionObserver = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            const name = (en.target as HTMLElement).dataset.trackSection || '';
            if (en.isIntersecting && name && !seen.has(name)) {
              seen.add(name); sendEvent(`${pageName()} · section: ${name}`); sectionObserver?.unobserve(en.target);
            }
          });
        }, { threshold: 0, rootMargin: '0px 0px -35% 0px' });
        document.querySelectorAll('[data-track-section]').forEach((el) => sectionObserver!.observe(el));
      });

      // Time on page: only while the tab is visible, sent once when the visitor leaves
      const bucket = (sec: number) =>
        sec < 10 ? 'under 10s' : sec < 30 ? '10–30s' : sec < 60 ? '30s–1 min' : sec < 120 ? '1–2 min' : sec < 300 ? '2–5 min' : '5+ min';
      let visibleMs = 0, visibleSince = 0, timeSent = true, timePage = '';
      const startTimer = () => { timePage = pageName(); visibleMs = 0; visibleSince = document.visibilityState === 'visible' ? performance.now() : 0; timeSent = false; };
      const sendTime = () => {
        if (timeSent) return;
        timeSent = true;
        if (visibleSince) { visibleMs += performance.now() - visibleSince; visibleSince = 0; }
        const name = `${timePage} · time ${bucket(visibleMs / 1000)}`;
        const g = gc(); if (g) g.count({ path: name, title: name, event: true });
      };
      document.addEventListener('astro:page-load', startTimer);
      document.addEventListener('astro:before-preparation', sendTime);
      window.addEventListener('pagehide', sendTime);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
          if (visibleSince) { visibleMs += performance.now() - visibleSince; visibleSince = 0; }
          // On phones switching apps often never fires pagehide, so send after a short time in the background
          setTimeout(() => { if (document.visibilityState === 'hidden') sendTime(); }, 3000);
        } else if (!timeSent) {
          visibleSince = performance.now();
        }
      });

      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        const ev = href.endsWith('.pdf') ? ['cv-open', 'Open CV'] : href.includes('linkedin.com') ? ['linkedin-click', 'LinkedIn'] : href.startsWith('mailto:') ? ['email-click', 'Email'] : null;
        if (ev) whenReady(() => gc()!.count({ path: ev[0], title: ev[1], event: true }));
      });
    </script>
  </body>
</html>
