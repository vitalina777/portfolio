---
import { withBase } from '../../data/site';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Img from '../../components/Img.astro';
import Block from '../../components/Block.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { cases, getCase } from '../../data/cases';
import type { Case } from '../../data/types';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Case };
const next = getCase(c.next)!;
---
<Base title={c.title} description={c.tldr.outcome} current="work">
  <article>
    <header class="container case-hero intro">
      <a class="label back" href={withBase('/#work')}>All work</a>
      <p class="label eyebrow"><span class="accent">{c.number}</span>{c.eyebrow.map((e) => <span>{e}</span>)}</p>
      <h1 class="display-xl">{c.title}</h1>
      <p class="body-l measure">{c.subtitle}</p>
      <div class="hero-img" transition:name={`cover-${c.slug}`}><Img src={c.hero.src} alt={c.hero.alt} ratio={c.hero.ratio} eager /></div>
    </header>

    <div class="container">
      <dl class="snapshot" data-reveal-group>
        {c.snapshot.map((s) => <div><dt class="label label-s">{s.k}</dt><dd>{s.v}</dd></div>)}
      </dl>

      <section class="tldr" aria-labelledby="tldr" data-reveal data-track-section="TL;DR">
        <h2 id="tldr" class="label accent">TL;DR</h2>
        <div class="tldr-grid">
          <div><h3 class="h4">Challenge</h3><p>{c.tldr.challenge}</p></div>
          <div><h3 class="h4">What I did</h3><p>{c.tldr.did}</p></div>
          <div><h3 class="h4">Outcome</h3><p>{c.tldr.outcome}</p></div>
        </div>
      </section>

      <div data-reveal><Facts items={c.numbers} /></div>
    </div>

    {c.sections.map((s, i) => (
      <section class="container section" aria-labelledby={`s${i}`} data-track-section={s.label}>
        <div class="section-head" data-reveal>
          <SectionLabel n={String(i + 1).padStart(2, '0')} text={s.label} />
          <h2 id={`s${i}`} class="h2 heading">{s.heading}</h2>
          {s.lead && <p class="body-l measure">{s.lead}</p>}
        </div>
        <div class="blocks" data-reveal-group>{s.blocks?.map((b) => <Block b={b} />)}</div>
      </section>
    ))}

    {c.draft && (
      <div class="container section">
        <p class="draft label">Full case coming soon. The highlights above are final.</p>
      </div>
    )}

    <nav class="container section" aria-label="Next case" data-track-section="Next case">
      <a class="next" data-reveal href={withBase(`/work/${next.slug}/`)}>
        <span class="label">Next case</span>
        <span class="h2">{next.cardTitle}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .case-hero { display: grid; gap: 1.75rem; padding-block: 3rem 0; }
  .back { text-decoration: none; justify-self: start; min-height: 44px; display: inline-flex; align-items: center; }
  .back::before { content: '←'; margin-right: 0.5rem; }
  .back:hover { text-decoration: underline; }
  .eyebrow { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .case-hero h1 { max-width: 18ch; }
  .hero-img { margin-top: 1rem; border-radius: var(--radius-m); overflow: hidden; }
  .snapshot { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 1.5rem 2rem; padding-block: 3rem; margin: 0; }
  @media (min-width: 900px) { .snapshot { grid-template-columns: repeat(3, 1fr); } }
  .snapshot div { border-top: 1px solid var(--border); padding-top: 1rem; display: grid; gap: 0.5rem; align-content: start; }
  .snapshot dd { margin: 0; }
  .tldr { background: var(--bg-surface); border-radius: var(--radius-m); padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); display: grid; gap: 1.5rem; margin-bottom: 3rem; }
  .tldr-grid { display: grid; gap: 1.5rem 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .tldr-grid div { display: grid; gap: 0.5rem; align-content: start; }
  .tldr-grid p { color: var(--text-secondary); }
  .heading { max-width: 25em; }
  .blocks { display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr); }
  .case-hero { grid-template-columns: minmax(0, 1fr); }
  .case-hero h1 { overflow-wrap: break-word; hyphens: auto; }
  .draft { border: 1px dashed var(--border); border-radius: var(--radius-s); padding: 1.25rem; }
  .next { display: grid; gap: 0.75rem; text-decoration: none; border-top: 1px solid var(--border); padding-top: 2rem; }
  .next .h2 { max-width: 24ch; }
  .next:hover .h2 { text-decoration: underline; }
</style>
