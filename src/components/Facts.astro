---
interface Props { items: { v: string; l: string }[] }
const { items } = Astro.props;
---
<dl class="facts">
  {items.map((f) => (
    <div class="fact">
      <dd class="v">{f.v}</dd>
      <dt class="label label-s">{f.l}</dt>
    </div>
  ))}
</dl>
<style>
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); border-block: 1px solid var(--border); margin: 0; }
  .fact { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.375rem; padding: 1.5rem 1.25rem 1.5rem 0; }
  .fact + .fact { border-left: 1px solid var(--border); padding-left: 1.25rem; }
  .v { margin: 0; font-size: var(--stat); font-weight: 500; line-height: 1.1; letter-spacing: -0.02em; }
  @media (max-width: 720px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .fact + .fact { border-left: 0; padding-left: 0; }
    .fact { border-bottom: 1px solid var(--border); padding-right: 1rem; }
  }
</style>
