---
import Img from './Img.astro';
import Quote from './Quote.astro';
import Facts from './Facts.astro';
import type { Block } from '../data/types';
interface Props { b: Block }
const { b } = Astro.props;
---
{b.type === 'text' && (
  <div class="text measure">{b.paragraphs.map((p) => <p class="body-l">{p}</p>)}</div>
)}

{b.type === 'cards' && (
  <ul role="list" class="cards" style={`--cols:${b.columns ?? 3}`}>
    {b.items.map((i) => (
      <li class="card">
        {i.eyebrow && <p class="label label-s accent">{i.eyebrow}</p>}
        {i.title && <h3 class="h4">{i.title}</h3>}
        <p>{i.text}</p>
      </li>
    ))}
  </ul>
)}

{b.type === 'pills' && (
  <ul role="list" class="pills panel">
    {b.items.map((p, i) => <li>{b.numbered && <span class="num">{String(i + 1).padStart(2, '0')}</span>}{p}</li>)}
  </ul>
)}

{b.type === 'image' && (
  <figure class="figure">
    <Img src={b.image.src} alt={b.image.alt} ratio={b.image.ratio} />
    {b.image.caption && <figcaption class="label label-s">{b.image.caption}</figcaption>}
  </figure>
)}

{b.type === 'images' && (
  <div class="images">
    {b.images.map((im) => (
      <figure class="figure">
        <Img src={im.src} alt={im.alt} ratio={im.ratio} />
        {im.caption && <figcaption class="label label-s">{im.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}

{b.type === 'chain' && (
  <div class="card chain-card">
    <h3 class="h4">{b.title}</h3>
    <ol role="list" class="chain">{b.items.map((s) => <li>{s}</li>)}</ol>
    <p>{b.text}</p>
  </div>
)}

{b.type === 'flow' && (
  <div class="panel">
    <div class="card flow-card">
      <p class="badge">{b.badge}</p>
      <h3 class="h3">{b.title}</h3>
      <ol role="list" class="flow">{b.steps.map((s) => <li>{s}</li>)}</ol>
      <ul role="list" class="notes">{b.notes.map((n) => <li><strong>{n.title}</strong><span>{n.text}</span></li>)}</ul>
    </div>
  </div>
)}

{b.type === 'table' && (
  <div class="panel">
    <div class="table-wrap card" tabindex="0" role="region" aria-label={b.caption}>
      <table>
        <caption class="visually-hidden">{b.caption}</caption>
        <thead><tr>{b.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{b.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td><span class:list={['risk', c.toLowerCase().replace(/\s/g, '-')]}>{c}</span></td>)}</tr>)}</tbody>
      </table>
      {b.note && <p class="label label-s note">{b.note}</p>}
    </div>
  </div>
)}

{b.type === 'decision' && (
  <div class:list={['panel decision', { flip: b.flip }]}>
    {b.image && <div class="decision-img" data-reveal><Img src={b.image.src} alt={b.image.alt} ratio={b.image.ratio ?? '661 / 462'} /></div>}
    <div class="decision-cards" data-reveal-group>
      <div class="card">
        <p class="badge problem">{b.problemTag}</p>
        <p class="h4">{b.problem}</p>
        {b.meta && <p class="label label-s">{b.meta}</p>}
      </div>
      <div class="card">
        <p class="badge">Design decision</p>
        <h3 class="h4">{b.decisionTitle}</h3>
        <p>{b.decision}</p>
      </div>
    </div>
  </div>
)}

{b.type === 'stats' && <Facts items={b.items} />}

{b.type === 'outcomes' && (
  <ol role="list" class="outcomes">
    {b.items.map((o, i) => (
      <li class="card">
        <p class="label label-s accent">Outcome {String(i + 1).padStart(2, '0')}</p>
        <h3 class="h4">{o.title}</h3>
        <p>{o.text}</p>
      </li>
    ))}
  </ol>
)}

{b.type === 'quotes' && (
  <div class="quotes-wrap">
    {b.label && <p class="label">{b.label}</p>}
    <div class="quotes">{b.items.map((q) => <Quote quote={q.quote} who={q.who} />)}</div>
  </div>
)}

{b.type === 'steps' && (
  <div class="panel">
    <ol role="list" class="steps">
      {b.items.map((s, i) => (
        <li class="card step">
          <p class="label label-s accent">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="h4">{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    {b.note && <p class="steps-note">{b.note}</p>}
  </div>
)}

{b.type === 'media' && (
  <div class:list={['media', { 'text-first': b.textFirst, 'no-image': !b.image }]}>
    {b.image && <div class:list={['media-img', { framed: b.framed }]}><Img src={b.image.src} alt={b.image.alt} ratio={b.image.ratio ?? '16 / 9'} /></div>}
    <div class="media-text">
      {b.eyebrow && <p class="label label-s accent">{b.eyebrow}</p>}
      <h3 class="h3">{b.title}</h3>
      {b.text && <p>{b.text}</p>}
      {b.rows && (
        <dl class="media-rows">
          {b.rows.map((r) => <div><dt class="label label-s">{r.k}</dt><dd>{r.v}</dd></div>)}
        </dl>
      )}
    </div>
  </div>
)}

{b.type === 'palette' && (
  <div class="palette-wrap">
    {b.label && <p class="label">{b.label}</p>}
    <ul role="list" class="palette">
      {b.colors.map((c) => <li><span class="pal" style={`background:${c}`} aria-hidden="true"></span><span class="label label-s">{c}</span></li>)}
    </ul>
  </div>
)}

{b.type === 'tokens' && (
  <ul role="list" class="cards" style="--cols:3">
    {b.items.map((t) => (
      <li class="card">
        <p class="label label-s accent">Token change</p>
        <h3 class="h4"><s class="muted">{t.from}</s> → {t.to}</h3>
        <p>{t.text}</p>
        <ul role="list" class="swatches">
          {t.swatches.map((sw) => (
            <li>
              <span class="sw" style={sw.bg ? `background:${sw.bg};color:${sw.hex}` : `background:${sw.hex}`} aria-hidden="true">{sw.bg ? 'Aa' : ''}</span>
              <span class="sw-meta"><span class="label label-s">{sw.name} {sw.bg ? '' : sw.hex}</span><span class:list={['chip', sw.pass ? 'pass' : 'fail']}>{sw.ratio} · {sw.pass ? 'Pass' : 'Fail'}</span></span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
)}

{b.type === 'list' && (
  <div class="list-wrap">
    {b.label && <p class="label">{b.label}</p>}
    <ul role="list" class="list">{b.items.map((i) => <li><h3 class="h4">{i.title}</h3><p class="muted">{i.text}</p></li>)}</ul>
  </div>
)}

<style>
  .text { display: grid; gap: 1rem; }
  .panel { min-width: 0; background: linear-gradient(160deg, #E4EAF1, #D9E3EE); border-radius: var(--radius-m); padding: clamp(1rem, 0.5rem + 2.5vw, 3.5rem); }
  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-s); padding: 1.5rem; display: grid; gap: 0.75rem; align-content: start; }
  .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  @media (min-width: 900px) { .cards { grid-template-columns: repeat(var(--cols), 1fr); } }
  .pills { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .pills li { background: #fff; border-radius: 999px; padding: 0.625rem 1rem; display: inline-flex; gap: 0.5rem; font-size: 1rem; }
  .num { color: #007AC2; font-weight: 500; }
  .figure { display: grid; gap: 0.75rem; min-width: 0; }
  .figure figcaption { overflow-wrap: anywhere; }
  .images { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .chain { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .chain li { background: #CFE0F0; border-radius: 6px; padding: 0.375rem 0.75rem; }
  .chain li + li::before { content: '→'; margin-right: 0.5rem; color: #5D8EB6; }
  .badge { justify-self: start; background: #2E5E91; color: #fff; border-radius: 4px; padding: 0.125rem 0.5rem; font-size: 0.8125rem; }
  .badge.problem { background: #B42318; }
  .flow-card { padding: clamp(1.25rem, 1rem + 1.5vw, 2rem); gap: 1.25rem; }
  .flow { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .flow li { background: #EEF1F5; border-radius: 6px; padding: 0.5rem 0.875rem; }
  .flow li:last-child { background: #E3F4EA; color: #1E6B3E; }
  .notes { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .notes li { display: grid; gap: 0.25rem; }
  .table-wrap { overflow-x: auto; padding: 1.5rem; }
  table { border-collapse: collapse; width: 100%; min-width: 46rem; font-size: 0.9375rem; }
  th, td { text-align: left; vertical-align: top; padding: 0.875rem 0.75rem; border-bottom: 1px solid var(--border); }
  thead th { font-size: 0.8125rem; color: var(--text-muted); font-weight: 500; }
  tbody th { font-weight: 500; max-width: 18rem; }
  .risk { display: inline-block; padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.8125rem; }
  .low { background: #E3F4EA; color: #1E6B3E; } .medium { background: #FFF3D6; color: #7A4D00; } .high { background: #FCE4E4; color: #A12020; }
  .test-first, .test-next { background: #FFF3D6; color: #7A4D00; }
  .note { margin-top: 1rem; }
  .decision { display: grid; gap: 1.5rem; align-items: center; }
  .decision-cards { display: grid; gap: 0.75rem; }
  .decision-img { border-radius: var(--radius-s); overflow: hidden; }
  @media (min-width: 900px) {
    .decision { grid-template-columns: 1.35fr 1fr; }
    .decision.flip .decision-img { order: 2; }
    .decision.flip { grid-template-columns: 1fr 1.35fr; }
  }
  .outcomes { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .quotes-wrap, .list-wrap { display: grid; gap: 1.25rem; margin-top: 1rem; }
  .quotes { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .list { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .list li { border-top: 1px solid var(--border); padding-top: 1rem; display: grid; gap: 0.5rem; }
  .steps { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .step { position: relative; }
  .steps-note { margin-top: 1.25rem; color: var(--text-secondary); max-width: 52rem; }
  .swatches { display: grid; gap: 0.75rem; margin-top: 0.25rem; }
  .swatches li { display: flex; gap: 0.75rem; align-items: center; }
  .sw { width: 2.25rem; height: 2.25rem; border-radius: 6px; flex: none; display: grid; place-items: center; font-weight: 600; font-size: 0.875rem; }
  .sw-meta { display: grid; gap: 0.25rem; }
  .chip { justify-self: start; font-family: var(--font-mono); font-size: 0.75rem; padding: 0.125rem 0.5rem; border-radius: 999px; }
  .chip.pass { background: #E3F4EA; color: #1E6B3E; } .chip.fail { background: #FCE4E4; color: #A12020; }
  .palette-wrap { display: grid; gap: 1rem; }
  .palette { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); }
  .palette li { display: grid; gap: 0.5rem; }
  .pal { height: 4.5rem; border-radius: var(--radius-s); border: 1px solid var(--border); }
  .media { display: grid; gap: 2rem; align-items: center; }
  .media { padding-block: 0.5rem; }
  .media + .media { border-top: 1px solid var(--border); padding-top: 2rem; }
  .media-img { min-width: 0; }
  .media-img.framed { background: radial-gradient(120% 120% at 0% 0%, #EAF6F7, #C6E4E7); border-radius: var(--radius-m); padding: clamp(1rem, 0.5rem + 2vw, 2.5rem); }
  .media-img :global(img) { width: 100%; height: auto; border-radius: var(--radius-m); }
  .media-text { display: grid; gap: 0.875rem; align-content: start; min-width: 0; }
  .media-text > p { color: var(--text-secondary); }
  .media-rows { display: grid; margin: 0; }
  .media-rows div { border-top: 1px solid rgba(16, 18, 21, 0.12); padding-block: 0.75rem; display: grid; gap: 0.25rem; }
  .media-rows dd { margin: 0; }
  @media (min-width: 900px) {
    .media { grid-template-columns: 1.55fr 1fr; }
    .media.text-first { grid-template-columns: 1fr 1.55fr; }
    .media.text-first .media-text { order: -1; }
    .media.no-image { grid-template-columns: minmax(0, 46rem); }
  }
</style>
